# Database
DATABASE_URL="postgresql://fishlog:fishlog123@localhost:5432/fishlog?schema=public"

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secrets (REQUIRED - MUST BE SET IN PRODUCTION)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Optional - only if using social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=com.yourcompany.fishlog
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# AI - Google Gemini (Optional - only if using AI features)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
